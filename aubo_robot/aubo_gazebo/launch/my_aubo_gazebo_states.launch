<launch>
	<!-- 将Gazebo关节控制器的配置参数加载到参数服务器中 -->
    <rosparam file="$(find aubo_gazebo)/config/my_gazebo_joints_states.yaml" 
              command="load"/>
    <!-- 加载控制器 -->
	<node   name="controller_spawner" 
            pkg="controller_manager" 
            type="spawner" 
            respawn="false"
            output="screen" 
            ns="/aubo_i10" 
            args="joint_state_controller"/>
    <node   name='robot_state_publisher' 
            pkg='robot_state_publisher' 
            type='robot_state_publisher'
            respawn='false' 
            output='screen'>
    <remap  from='/joint_states' 
            to='/aubo_i10/joint_states'/>
    </node>
</launch>